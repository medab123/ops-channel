{
    "name": "medox/ops-channel",
    "description": "OpsChannel - run an Artisan command on a deployed Laravel application over a signed, single-use Ed25519 challenge-response handshake.",
    "type": "library",
    "keywords": ["laravel", "artisan", "ed25519", "handshake", "operations"],
    "license": "MIT",
    "authors": [
        {
            "name": "Mohammed Elabidi",
            "email": "mohammed.elabidi123@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3|^8.4",
        "ext-sodium": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "spatie/laravel-data": "^4.19"
    },
    "require-dev": {
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5.3|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Medox\\OpsChannel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Medox\\OpsChannel\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Medox\\OpsChannel\\OpsChannelServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "optimize-autoloader": true
    }
}
